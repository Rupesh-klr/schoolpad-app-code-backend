# Hostinger Node app — environment variables
#
# Paste these into hPanel -> Set environment variables (the "Import .env" button
# accepts this file directly). Fill in every PASTE_ value first.
#
#   API : https://sample-demo-learing.holistichealervedika.com
#   Web : https://sample-learing-schoolpad.holistichealervedika.com

# ─── Server ───────────────────────────────────────────────────────────────────

# production changes real behaviour, not just a label:
#   - error responses stop including messages and stack traces
#   - JWT_REFRESH_SECRET becomes mandatory
#   - OTP_PROVIDER=console is refused, because it prints live OTPs to the log
# Read the OTP section below before setting this.
NODE_ENV=production

# Hostinger injects its own PORT for the Node addon and proxies the domain to
# it. The app already prefers process.env.PORT, so this is only the fallback
# for when the platform does not set one. If the domain returns 502, this
# mismatching is the first thing to check.
PORT=8100

# The FRONTEND origin — the address in the browser's URL bar when it calls this
# API. Not this API's own domain. Exact match: https, no trailing slash.
# Leaving it empty allows every origin, which is not what you want in public.
CORS_ORIGIN=https://sample-learing-schoolpad.holistichealervedika.com

# ─── Database ─────────────────────────────────────────────────────────────────

# localhost when MySQL runs on the same Hostinger host, which is the usual
# setup. If hPanel shows a separate database hostname, use that instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PASTE_DATABASE_NAME
DB_USER=PASTE_DATABASE_USER
DB_PASSWORD=PASTE_DATABASE_PASSWORD

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Generate each separately, and never reuse the development values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Two different secrets on purpose: a leak of one does not forge the other.
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=PASTE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP delivery ─────────────────────────────────────────────────────────────

# This is the one setting that will stop the app booting under
# NODE_ENV=production, and it is deliberate: `console` prints every OTP to the
# server log in plaintext, which on a public host is a way in to any account.
#
# whatsapp — reuse the Meta credentials already working in SupportHelper.
# smtp     — NOT implemented; the code returns 501 rather than silently not
#            sending. Wire nodemailer in services/otp.js first.
OTP_PROVIDER=whatsapp

WHATSAPP_PHONE_NUMBER_ID=PASTE_META_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=PASTE_META_ACCESS_TOKEN
WHATSAPP_TEMPLATE_NAME=PASTE_APPROVED_AUTHENTICATION_TEMPLATE_NAME

# ─── Uploads ──────────────────────────────────────────────────────────────────

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=120

# ─── First admin ──────────────────────────────────────────────────────────────

# `npm run seed` refuses to run under NODE_ENV=production, so these are only
# read if you seed with NODE_ENV unset. Create the first admin deliberately
# instead, then remove these two lines.
SEED_ADMIN_EMAIL=PASTE_ADMIN_EMAIL
SEED_ADMIN_PASSWORD=PASTE_A_STRONG_PASSWORD
