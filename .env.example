# Copy to .env and fill in. Never commit the filled copy.
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8100
# Comma-separated. The Expo web build and the dev server both need to be listed.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL 8 or MariaDB 10.5+.
#
# Every table this app owns is prefixed ls_ (learning system), so it shares
# acastahealthapp with the Spring backend without colliding — that schema
# already owns `user`, `otp`, `admin_user`, `question` and a dozen more.
# The prefix is fixed in schema.sql; it is not configurable.
#
# `npm run migrate -- --drop` drops only ls_ tables, never the database.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acastahealthapp
DB_USER=root
DB_PASSWORD=PASTE_DB_PASSWORD

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Signs access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
# Refresh tokens live longer and are stored hashed in the database, so this one
# being different from JWT_SECRET limits the blast radius if either leaks.
JWT_REFRESH_SECRET=PASTE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP delivery ─────────────────────────────────────────────────────────────
# console = print the OTP to the server log instead of sending it. The only
# provider that needs no credentials, so registration is testable on day one.
OTP_PROVIDER=console
# When OTP_PROVIDER=whatsapp, these are reused from the SupportHelper setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
# When OTP_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# ─── Uploads ──────────────────────────────────────────────────────────────────
# local = write to ./uploads and serve from /media. Swap to s3 in production.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=512

# ─── First admin ──────────────────────────────────────────────────────────────
# `npm run seed` creates exactly this one admin, then never touches it again.
# Change the password immediately after the first sign-in.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=PASTE_A_STRONG_PASSWORD
SEED_ADMIN_NAME=Platform Admin
